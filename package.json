  "keywords": [
    "agent-skill",
    "pi-package",
    "claude-code-plugin",
    "codex-skill"
  ],
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Appit-labs/repo-runbook.git"
  },
  "author": {
    "name": "Ibrahim M. Badr",
    "url": "https://github.com/ibrahimbdr"
  },
  "contributors": [
    {
      "name": "Appit Labs",
      "url": "https://github.com/Appit-Labs"
    }
  ]
}
